export module [
    ;---------------------------
    ; Initialization
    ;---------------------------

    init: method [][
        \unicodeData: read.lines ./"data.txt"
        \unicodeDataSize: size \unicodeData
    ]

    ;---------------------------
    ; Public methods
    ;---------------------------

    unidecode: method.public [str][
        if empty? str -> return ""

        result: ""
        loop str 'ch [
            c: to :integer ch
            switch c =< 127 [
                'result ++ ch
            ][
                if (c - 128) < \unicodeDataSize [
                    'result ++ \unicodeData\[c - 128]
                ]
            ]
        ]
        result
    ]
]